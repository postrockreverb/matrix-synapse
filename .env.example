# =============================================================================
# Matrix Synapse Docker Compose - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These variables are used by Docker Compose at runtime (Caddy and PostgreSQL).
# All other configuration is edited directly in the config files.
# =============================================================================

# --- Caddy (reverse proxy hostnames) ---
SYNAPSE_HOSTNAME=matrix.example.com
ELEMENT_HOSTNAME=element.example.com

# --- Domain (your Matrix server_name, e.g. baraso.app) ---
DOMAIN=example.com

# --- LiveKit / MatrixRTC ---
LIVEKIT_HOSTNAME=livekit.example.com
LIVEKIT_API_KEY=CHANGEME_GENERATE_WITH_openssl_rand_base64_16
LIVEKIT_API_SECRET=CHANGEME_GENERATE_WITH_openssl_rand_base64_32

# --- PostgreSQL ---
POSTGRES_USER=synapse
POSTGRES_PASSWORD=CHANGEME_GENERATE_WITH_openssl_rand_hex_32
POSTGRES_DB=synapse
