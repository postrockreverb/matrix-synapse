# =============================================================================
# Matrix Synapse Docker Compose - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These variables are used by Docker Compose at runtime (reverse proxy,
# lk-jwt-service, and PostgreSQL).
# All other configuration is edited directly in the config files.
# =============================================================================

# --- Reverse proxy hostnames ---
SYNAPSE_HOSTNAME=CHANGEME_SYNAPSE_HOSTNAME
ELEMENT_HOSTNAME=CHANGEME_ELEMENT_HOSTNAME

# --- Domain (your Matrix server_name) ---
DOMAIN=CHANGEME_DOMAIN

# --- LiveKit / MatrixRTC ---
LIVEKIT_HOSTNAME=CHANGEME_LIVEKIT_HOSTNAME
LIVEKIT_API_KEY=CHANGEME_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGEME_LIVEKIT_API_SECRET

# --- PostgreSQL ---
POSTGRES_USER=CHANGEME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
POSTGRES_DB=CHANGEME_POSTGRES_DB
