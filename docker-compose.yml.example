services:
  # ===========================================================================
  # PostgreSQL - Database backend for Synapse
  # ===========================================================================
  postgres:
    image: postgres:16-alpine
    container_name: matrix-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      POSTGRES_INITDB_ARGS: "--encoding=UTF-8 --lc-collate=C --lc-ctype=C"
    volumes:
      - CHANGEME_VOLUMES_PATH/postgres_data:/var/lib/postgresql/data
    networks:
      - matrix_internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER}"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ===========================================================================
  # Synapse - Matrix homeserver
  # ===========================================================================
  synapse:
    image: matrixdotorg/synapse:latest
    container_name: matrix-synapse
    restart: unless-stopped
    environment:
      SYNAPSE_CONFIG_PATH: /data/homeserver.yaml
    volumes:
      - ./synapse:/data
      - CHANGEME_VOLUMES_PATH/synapse_media:/data/media_store
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - matrix_internal
      - npm_external

  # ===========================================================================
  # Element Web - Matrix web client
  # ===========================================================================
  element:
    image: vectorim/element-web:latest
    container_name: matrix-element
    restart: unless-stopped
    volumes:
      - ./element/config.json:/app/config.json:ro
    networks:
      - npm_external

  # ===========================================================================
  # coturn - TURN/STUN server for VoIP and screen sharing
  # ===========================================================================
  # NOTE: coturn uses host networking because Docker port-range mapping creates
  # one iptables rule per port, which is extremely inefficient for the relay
  # port range (49152-49200+). Host networking avoids this entirely.
  coturn:
    image: coturn/coturn:latest
    container_name: matrix-coturn
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./coturn/turnserver.conf:/etc/turnserver.conf:ro

  # ===========================================================================
  # LiveKit - SFU for Element Call / MatrixRTC
  # ===========================================================================
  livekit:
    image: livekit/livekit-server:latest
    container_name: matrix-livekit
    restart: unless-stopped
    command: --config /etc/livekit.yaml
    ports:
      - "7881:7881/tcp"              # WebRTC TCP fallback (direct, not proxied)
      - "50000-50200:50000-50200/udp" # WebRTC media (direct, not proxied)
    volumes:
      - ./livekit/config.yaml:/etc/livekit.yaml:ro
    networks:
      - npm_external

  # ===========================================================================
  # lk-jwt-service - LiveKit token service for MatrixRTC
  # ===========================================================================
  lk-jwt-service:
    image: ghcr.io/element-hq/lk-jwt-service:0.4.1
    container_name: matrix-lk-jwt-service
    restart: unless-stopped
    environment:
      LIVEKIT_URL: "wss://${LIVEKIT_HOSTNAME}"
      LIVEKIT_KEY: "${LIVEKIT_API_KEY}"
      LIVEKIT_SECRET: "${LIVEKIT_API_SECRET}"
      LIVEKIT_FULL_ACCESS_HOMESERVERS: "${DOMAIN}"
    extra_hosts:
      - "${DOMAIN}:host-gateway"
      - "${SYNAPSE_HOSTNAME}:host-gateway"
      - "${LIVEKIT_HOSTNAME}:host-gateway"
    networks:
      - npm_external

networks:
  matrix_internal:
    # Synapse <-> Postgres only
  npm_external:
    # Pre-existing NPM network — containers join it to be reachable by name
    external: true
