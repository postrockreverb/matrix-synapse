# =============================================================================
# coturn - TURN/STUN server configuration
# =============================================================================
# Edit this file directly. Replace every CHANGEME_* value with your own.
#
# This enables VoIP calls, video calls, and screen sharing to work reliably
# when users are behind NAT/firewalls.
# =============================================================================

# --- Authentication ---
# Use the shared secret (same as turn_shared_secret in homeserver.yaml)
# Synapse generates time-limited credentials from this secret
use-auth-secret
static-auth-secret=CHANGEME_TURN_SECRET

# --- Network ---
# STUN/TURN listening ports
listening-port=3478
tls-listening-port=5349

# Relay port range (must match firewall rules)
min-port=49152
max-port=49200

# External IP - REQUIRED for NAT traversal to work
# Replace with your VPS public IP
external-ip=CHANGEME_VPS_PUBLIC_IP

# Realm should match your Synapse hostname
realm=CHANGEME_SYNAPSE_HOSTNAME

# --- Security ---
# Only allow UDP relay (VoIP is all UDP, no reason for TCP relay)
no-tcp-relay

# Block relay connections to private IP ranges
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=240.0.0.0-255.255.255.255

# --- Performance ---
# Fingerprinting as per RFC 5769
fingerprint

# Long-term credential mechanism
lt-cred-mech

# Verbose logging (set to blank or remove for production)
# verbose

# --- TLS (optional) ---
# If you want TURNS (TLS-encrypted TURN), provide cert paths:
# cert=/etc/ssl/certs/turn.pem
# pkey=/etc/ssl/private/turn.key

# --- Logging ---
log-file=stdout
no-stdout-log
